# ============================================================
# 后端环境变量模板
# 复制为 .env 后按实际情况填写；.env 已被 .gitignore 忽略，不要提交
# 生成随机密钥：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================

# ---- 必填 ----

# JWT 签名密钥，长度至少 32 位。缺失时服务拒绝启动（不再有硬编码兜底）
JWT_SECRET=

# ---- 数据库 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=sport_compete

# ---- 服务 ----
PORT=4100
# token 有效期，默认 2h
JWT_TTL=2h

# ---- 跨域白名单（逗号分隔；留空表示不限制，仅内网使用时可以留空）----
CORS_ORIGINS=

# ============================================================
# 以下变量供根目录的部署/运维脚本使用（不在后端进程内使用）
# 设置方式：export SPORT_SSH_PASSWORD=... 后再跑 deploy_*.py / test_*.py
# ============================================================
# SPORT_SSH_HOST=10.128.1.45
# SPORT_SSH_USER=single
# SPORT_SSH_PASSWORD=
# SPORT_SUDO_PASSWORD=
# SPORT_DB_PASSWORD=
